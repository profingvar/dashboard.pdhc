FLASK_ENV=development
FLASK_APP=app:create_app
APP_PORT=9027

DB_HOST=localhost
DB_PORT=9026
DB_NAME=dashboard_pdhc_db
DB_USER=dashboard
DB_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg2://dashboard:changeme@localhost:9026/dashboard_pdhc_db

AUTH_MODE=off
SSO_BASE_URL=https://sso.pdhc.se
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=https://dashboard.pdhc.se/auth/callback
GATEWAY_BASE_URL=https://gateway.pdhc.se

# CDR1 (production CDR) — clinical patient picker + per-patient reads
# (#462 D2-D3 / #465). Care-delivery basis only; distinct from
# Cross-service base URLs are the PUBLIC subdomain (#830). The loopback form
# bypasses the reverse proxy, so a call verified that way has not been verified
# over the path real traffic takes.
CDR1_BASE_URL=https://cdr.pdhc.se

# CDR_ENDPOINTS is <name>=<base url> pairs, comma separated. DEPLOYED-ONLY
# until 2026-10-16: it existed on the server and in no committed file, so a
# rollback would have lost it silently. cdr4/cdr5 were destroyed 2026-10-05 and
# must not be listed.
CDR_ENDPOINTS=cdr1=https://cdr.pdhc.se,cdr2=https://cdr2.pdhc.se,cdr3=https://cdr3.pdhc.se

# SPARR_LIFT_ENABLED was also DEPLOYED-ONLY until 2026-10-16. It is `true` in
# production, gated on the 2026-08-20 DPO lift (#242/#241/#472), and the
# exposure it permits is audited as sparr_lift_exposure. Default it to false
# anywhere that lift has not been granted.
# Outbound service key the dashboard presents to CDR1/CDR2-6
# (X-Source-Service: dashboard.pdhc). Must match the CDR side.
DASHBOARD_PDHC_SERVICE_KEY=

SECRET_KEY=replace-me

SPARR_LIFT_ENABLED=false
